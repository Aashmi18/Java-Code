12)//Maximize the Distance Between Points on a Square

import java.util.*;

class Solution {
    long[] nums;
    int n;
    long perimeter;
    int k;

    public int maxDistance(int side, int[][] points, int k) {
        this.k = k;
        n = points.length;
        perimeter = 4L * side;

        nums = new long[2 * n];

        long[] temp = new long[n];

        for (int i = 0; i < n; i++) {
            int x = points[i][0];
            int y = points[i][1];

            if (x == 0)
                temp[i] = y;
            else if (y == side)
                temp[i] = side + x;
            else if (x == side)
                temp[i] = 3L * side - y;
            else
                temp[i] = 4L * side - x;
        }

        Arrays.sort(temp);

        for (int i = 0; i < n; i++) {
            nums[i] = temp[i];
            nums[i + n] = temp[i] + perimeter;
        }

        long low = 1;
        long high = side;

        while (low < high) {
            long mid = (low + high + 1) / 2;

            if (check(mid))
                low = mid;
            else
                high = mid - 1;
        }

        return (int) low;
    }

    boolean check(long dist) {
        for (int i = 0; i < n; i++) {
            long start = nums[i];
            long end = start + perimeter - dist;
            long current = start;

            boolean possible = true;

            for (int j = 1; j < k; j++) {
                int next = lowerBound(current + dist);

                if (next >= 2 * n || nums[next] > end) {
                    possible = false;
                    break;
                }

                current = nums[next];
            }

            if (possible)
                return true;
        }

        return false;
    }

    int lowerBound(long target) {
        int left = 0;
        int right = 2 * n;

        while (left < right) {
            int mid = (left + right) / 2;

            if (nums[mid] < target)
                left = mid + 1;
            else
                right = mid;
        }

        return left;
    }
}

13)//rotated digits

class Solution {
    public int rotatedDigits(int n) {
        int count = 0;

        for (int i = 1; i <= n; i++) {
            int num = i;
            boolean valid = true;
            boolean different = false;

            while (num > 0) {
                int digit = num % 10;

                if (digit == 2 || digit == 5 ||
                    digit == 6 || digit == 9) {
                    if (digit == 2 || digit == 5 ||
                        digit == 6 || digit == 9)
                        different = true;
                } else if (digit == 0 || digit == 1 || digit == 8) {
                } else {
                    valid = false;
                    break;
                }

                num /= 10;
            }

            if (valid && different)
                count++;
        }

        return count;
    }
}

14)//Maximum Path Score in a Grid

class Solution {
    public int maxPathScore(int[][] grid, int k) {
        int m = grid.length;
        int n = grid[0].length;

        int[][][] dp = new int[m][n][k + 1];

        for (int i = 0; i < m; i++)
            for (int j = 0; j < n; j++)
                for (int c = 0; c <= k; c++)
                    dp[i][j][c] = -1;

        int cost = grid[0][0] == 0 ? 0 : 1;

        if (cost > k)
            return -1;

        dp[0][0][cost] = grid[0][0];

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                for (int c = 0; c <= k; c++) {
                    if (dp[i][j][c] == -1)
                        continue;

                    if (i + 1 < m) {
                        int nc = c + (grid[i + 1][j] == 0 ? 0 : 1);

                        if (nc <= k) {
                            dp[i + 1][j][nc] = Math.max(
                                dp[i + 1][j][nc],
                                dp[i][j][c] + grid[i + 1][j]
                            );
                        }
                    }

                    if (j + 1 < n) {
                        int nc = c + (grid[i][j + 1] == 0 ? 0 : 1);

                        if (nc <= k) {
                            dp[i][j + 1][nc] = Math.max(
                                dp[i][j + 1][nc],
                                dp[i][j][c] + grid[i][j + 1]
                            );
                        }
                    }
                }
            }
        }

        int ans = -1;

        for (int c = 0; c <= k; c++)
            ans = Math.max(ans, dp[m - 1][n - 1][c]);

        return ans;
    }
}

15)//Max score from grid operations 

class Solution {
    public long maximumScore(int[][] grid) {
        int n = grid.length;

        if (n == 1)
            return 0;

        long[][] s = new long[n][n + 1];

        for (int j = 0; j < n; j++) {
            for (int i = 0; i < n; i++) {
                s[j][i + 1] = s[j][i] + grid[i][j];
            }
        }

        long INF = Long.MIN_VALUE / 2;

        long[][] dp = new long[n + 1][n + 1];

        for (int i = 0; i <= n; i++) {
            for (int j = 0; j <= n; j++) {
                dp[i][j] = INF;
            }
        }

        for (int h = 0; h <= n; h++) {
            dp[h][0] = 0;
        }

        for (int col = 0; col < n - 1; col++) {
            long[][] next = new long[n + 1][n + 1];

            for (int i = 0; i <= n; i++) {
                for (int j = 0; j <= n; j++) {
                    next[i][j] = INF;
                }
            }

            for (int h1 = 0; h1 <= n; h1++) {
                long[] pre = new long[n + 2];
                long[] suf = new long[n + 2];

                for (int i = 0; i <= n + 1; i++) {
                    pre[i] = INF;
                    suf[i] = INF;
                }

                pre[0] = dp[h1][0];

                for (int h2 = 1; h2 <= n; h2++) {
                    pre[h2] = Math.max(pre[h2 - 1], dp[h1][h2]);
                }

                for (int h2 = n; h2 >= 0; h2--) {
                    long val = INF;

                    if (dp[h1][h2] != INF) {
                        val = dp[h1][h2] +
                              Math.max(0L, s[col][h2] - s[col][h1]);
                    }

                    suf[h2] = Math.max(suf[h2 + 1], val);
                }

                for (int hp = 0; hp <= n; hp++) {
                    long add = Math.max(0L, s[col][hp] - s[col][h1]);

                    long v1 = INF;

                    if (pre[hp] != INF) {
                        v1 = pre[hp] + add;
                    }

                    next[hp][h1] = Math.max(v1, suf[hp + 1]);
                }
            }

            dp = next;
        }

        long ans = 0;

        for (int h1 = 0; h1 <= n; h1++) {
            for (int h2 = 0; h2 <= n; h2++) {
                if (dp[h1][h2] != INF) {
                    ans = Math.max(
                        ans,
                        dp[h1][h2] +
                        Math.max(0L, s[n - 1][h2] - s[n - 1][h1])
                    );
                }
            }
        }

        return ans;
    }
}

16)//Minimum Operations to Make a Uni-Value Grid


import java.util.*;

class Solution {
    public int minOperations(int[][] grid, int x) {
        int m = grid.length;
        int n = grid[0].length;

        int[] arr = new int[m * n];
        int k = 0;

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                arr[k++] = grid[i][j];
            }
        }

        for (int i = 0; i < arr.length; i++) {
            if ((arr[i] - arr[0]) % x != 0)
                return -1;
        }

        Arrays.sort(arr);

        int median = arr[arr.length / 2];
        int operations = 0;

        for (int num : arr) {
            operations += Math.abs(num - median) / x;
        }

        return operations;
    }
}
